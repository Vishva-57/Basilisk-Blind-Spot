generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id        String   @id @default(cuid())
  url       String
  score     Int
  results   String
  createdAt DateTime @default(now())

  @@index([url])
  @@index([createdAt])
}
